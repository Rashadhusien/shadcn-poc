{
  "name": "diagnostix-shadcn-port",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run theme:build",
    "build": "tsc -b && vite build",
    "prebuild": "npm run theme:build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:seed": "node scripts/check-seed.mjs",
    "theme:build": "node scripts/build-theme-css.mjs",
    "contrast": "node scripts/contrast.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run check:tokens && npm run check:seed && npm run contrast",
    "format": "prettier --write eslint.config.js .prettierrc package.json components.json vite.config.ts tsconfig*.json index.html \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check eslint.config.js .prettierrc package.json components.json vite.config.ts tsconfig*.json index.html \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  }
}
